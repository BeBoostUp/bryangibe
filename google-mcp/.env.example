# ==== MCP de Google unificado — copia a ".env" y rellena. NUNCA subas el .env a Git. ====
# Solo se admiten dos cuentas: bryan (bryan@bryangibe.com) y academy (academy@bryangibe.com).

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Se generan con:  python3 get_refresh_token.py bryan   /   python3 get_refresh_token.py academy
GOOGLE_REFRESH_TOKEN_BRYAN=
GOOGLE_REFRESH_TOKEN_ACADEMY=

GOOGLE_ADS_API_VERSION=v25
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID_BRYAN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID_ACADEMY=

# Opcional: API key para PageSpeed / CrUX
GOOGLE_API_KEY=
